{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waldo1001.github.io/waldo.BCObservatory/schemas/frontmatter.base.json",
  "title": "Frontmatter shared by every generated page",
  "type": "object",
  "required": ["id", "type", "title", "summary", "tier", "language", "review", "generated", "evidence", "links"],
  "properties": {
    "id": { "type": "string", "pattern": "^(topic|feature|object|localization|source|video|post|digest|change|app|release)/[A-Za-z0-9_-][A-Za-z0-9/_.-]*$", "description": "<type>/<slug>; video ids keep the case-sensitive YouTube id" },
    "type": { "enum": ["topic", "feature", "object", "localization", "source", "video", "post", "digest", "change", "app", "release"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
    "tier": { "enum": ["official", "community", "mixed"] },
    "language": { "type": "string", "pattern": "^[a-z]{2}$" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "system": { "type": "string", "description": "galaxy system id from config/taxonomy.json" },
    "versions": { "type": "object", "properties": { "introduced": { "type": ["string", "null"] }, "last_changed": { "type": ["string", "null"] }, "deprecated": { "type": ["string", "null"] } } },
    "review": {
      "type": "object", "required": ["state"],
      "properties": { "state": { "enum": ["derived", "unreviewed", "reviewed", "flagged"], "description": "D77: derived = no model text on the page (by and at null); unreviewed = model text Opus has not checked; reviewed = passed an Opus review; flagged = failed one" }, "by": { "type": ["string", "null"] }, "at": { "type": ["string", "null"] }, "flags": { "type": "array", "items": { "type": "string" } } }
    },
    "generated": {
      "type": "object", "required": ["at", "pipeline"],
      "properties": { "at": { "type": "string" }, "pipeline": { "type": "string" }, "prompts": { "type": "object" }, "input_hash": { "type": ["string", "null"] } }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "required": ["kind", "url"],
        "properties": {
          "kind": { "enum": ["learn", "code", "video", "blog", "guideline", "roadmap", "marketplace"] },
          "url": { "type": "string" }, "title": { "type": "string" }, "date": { "type": ["string", "null"] },
          "commit": { "type": ["string", "null"] }, "t": { "type": ["integer", "null"] },
          "quote": { "type": ["string", "null"], "maxLength": 240 }
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "learn": { "type": "array", "items": { "type": "string" } }, "objects": { "type": "array", "items": { "type": "string" } },
        "features": { "type": "array", "items": { "type": "string" } }, "topics": { "type": "array", "items": { "type": "string" } },
        "localizations": { "type": "array", "items": { "type": "string" } }, "videos": { "type": "array", "items": { "type": "string" } },
        "posts": { "type": "array", "items": { "type": "string" } }, "guidelines": { "type": "array", "items": { "type": "string" } },
        "changes": { "type": "array", "items": { "type": "string" }, "description": "D61: change pages (merged pull requests) that touched this page's object" }
      }
    }
  }
}
