{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waldo1001.github.io/waldo.BCObservatory/schemas/frontmatter.release.json",
  "title": "Frontmatter of an AL Language extension release page (content/releases/al-<version>.md, D85)",
  "allOf": [{ "$ref": "frontmatter.base.json" }],
  "type": "object",
  "required": ["source_id", "extension", "version", "wave", "major", "preview_at", "released_at", "published_at", "prerelease", "entry_count", "issues", "changes"],
  "properties": {
    "type": { "const": "release" },
    "source_id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "the sources.yaml id (al-language-extension)" },
    "extension": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" },
    "version": { "type": "string", "minLength": 1, "description": "the changelog's own version text: 18.0, 4.0.0, 9.3 Update 2" },
    "wave": { "type": ["string", "null"], "description": "the changelog's wave H1 without 'Business Central '" },
    "major": { "type": ["string", "null"], "pattern": "^\\d+$", "description": "the BC major of the wave (config/versions.json labels); null before BC23 and for 'update' waves" },
    "preview_at": { "$ref": "#/$defs/date" },
    "released_at": { "$ref": "#/$defs/date" },
    "published_at": { "$ref": "#/$defs/date", "description": "released_at ?? preview_at; null when the gallery holds no upload of the version" },
    "prerelease": { "type": "boolean", "description": "no stable upload of this version" },
    "entry_count": { "type": "integer", "minimum": 0 },
    "issues": { "type": "array", "items": { "type": "integer" }, "uniqueItems": true },
    "changes": {
      "type": "array", "description": "the diffs that touched this version after its first snapshot, newest first",
      "items": {
        "type": "object", "required": ["at", "added", "changed", "removed"], "additionalProperties": false,
        "properties": {
          "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "added": { "type": "array", "items": { "type": "string" } }, "changed": { "type": "array", "items": { "type": "string" } },
          "removed": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": { "date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }
}
