{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waldo1001.github.io/waldo.BCObservatory/schemas/release-diff.json",
  "title": "AL Language extension changelog diff (data/releases/al/diffs/<date>.json, D85)",
  "type": "object",
  "required": ["from", "to", "added", "removed", "changed", "entries"],
  "additionalProperties": false,
  "properties": {
    "from": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "the previous snapshot's date; null on the first snapshot" },
    "to": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "added": { "type": "array", "items": { "type": "string" } },
    "removed": { "type": "array", "items": { "type": "string" } },
    "changed": { "type": "array", "items": { "type": "string" } },
    "entries": {
      "type": "object", "description": "per changed version whose entries changed: entry slugs added, changed, removed",
      "additionalProperties": {
        "type": "object", "required": ["added", "changed", "removed"], "additionalProperties": false,
        "properties": {
          "added": { "type": "array", "items": { "type": "string" } }, "changed": { "type": "array", "items": { "type": "string" } },
          "removed": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
