{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waldo1001.github.io/waldo.BCObservatory/schemas/al-object.json",
  "title": "Extracted AL object (al-object@1), one JSONL line per object",
  "type": "object",
  "required": ["schema", "version", "country", "layer", "type", "id", "name", "file", "hash"],
  "properties": {
    "schema": { "const": "al-object@1" },
    "version": { "type": "string" }, "build": { "type": ["string", "null"] },
    "country": { "type": "string" }, "layer": { "enum": ["base", "overlay"] },
    "app": { "type": ["string", "null"] }, "namespace": { "type": ["string", "null"] },
    "type": { "enum": ["table", "tableextension", "page", "pageextension", "codeunit", "report", "reportextension", "query", "xmlport", "enum", "enumextension", "interface", "permissionset", "permissionsetextension", "entitlement", "profile", "controladdin", "pagecustomization", "dotnet"] },
    "id": { "type": ["integer", "null"] }, "name": { "type": "string" }, "extends": { "type": ["string", "null"] },
    "file": { "type": "string" }, "file_hash": { "type": ["string", "null"] }, "commit": { "type": ["string", "null"] },
    "properties": { "type": "object" },
    "obsolete": { "$ref": "#/$defs/obsolete" },
    "fields": { "type": "array", "items": { "type": "object", "required": ["id", "name", "type"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "type": { "type": "string" }, "properties": { "type": "object" }, "tooltip": { "type": ["string", "null"] }, "obsolete": { "$ref": "#/$defs/obsolete" }, "clean": { "$ref": "#/$defs/clean" } } } },
    "values": { "type": "array", "description": "enum values", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "properties": { "type": "object" }, "obsolete": { "$ref": "#/$defs/obsolete" }, "clean": { "$ref": "#/$defs/clean" } } } },
    "keys": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "fields": { "type": "array", "items": { "type": "string" } }, "clustered": { "type": "boolean" } } } },
    "procedures": { "type": "array", "items": { "type": "object", "required": ["name", "scope"], "properties": {
      "name": { "type": "string" }, "scope": { "enum": ["global", "local", "internal", "protected"] },
      "params": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "var": { "type": "boolean" } } } },
      "returns": { "type": ["string", "null"] },
      "attributes": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "args": { "type": "array" } } } },
      "event": { "enum": ["integration", "business", "internal", "subscriber", null] },
      "subscribes_to": { "type": ["object", "null"], "properties": { "object_type": { "type": "string" }, "object_name": { "type": "string" }, "event": { "type": "string" }, "element": { "type": ["string", "null"] } } },
      "obsolete": { "$ref": "#/$defs/obsolete" }, "doc": { "type": ["string", "null"] }, "line": { "type": "integer" },
      "clean": { "$ref": "#/$defs/clean" }
    } } },
    "triggers": { "type": "array", "items": { "type": "string" } },
    "controls": { "type": "array", "description": "pages and page extensions, extractor 4 on (D65): layout controls in source order", "items": { "type": "object", "required": ["name", "kind", "source_expr", "caption", "tooltip", "group"], "properties": {
      "name": { "type": "string" }, "kind": { "enum": ["field", "part", "usercontrol", "label", "modify"] },
      "source_expr": { "type": ["string", "null"], "description": "the binding as written: Rec.\"No.\", a variable or an expression; the subpage of a part, the add-in of a usercontrol" },
      "caption": { "type": ["string", "null"] }, "tooltip": { "type": ["string", "null"] },
      "group": { "type": ["string", "null"], "description": "nearest container's Caption, else its name, else the area; in a page extension the anchor, e.g. addafter(Name)" },
      "properties": { "type": "object", "description": "every other property, values clipped at 300 characters" },
      "obsolete": { "$ref": "#/$defs/obsolete" }, "clean": { "$ref": "#/$defs/clean" }
    } } },
    "actions": { "type": "array", "description": "pages and page extensions, extractor 4 on (D65): actions in source order, without promoted actionrefs and separators", "items": { "type": "object", "required": ["name", "kind", "caption", "tooltip", "run_object", "group"], "properties": {
      "name": { "type": "string" }, "kind": { "enum": ["action", "customaction", "systemaction", "fileuploadaction", "modify"] },
      "caption": { "type": ["string", "null"] }, "tooltip": { "type": ["string", "null"] },
      "run_object": { "type": ["object", "null"], "required": ["type", "name", "id"], "properties": { "type": { "type": "string" }, "name": { "type": ["string", "null"] }, "id": { "type": ["integer", "null"] } } },
      "group": { "type": ["string", "null"] },
      "properties": { "type": "object" },
      "obsolete": { "$ref": "#/$defs/obsolete" }, "clean": { "$ref": "#/$defs/clean" }
    } } },
    "clean": { "$ref": "#/$defs/clean" },
    "parse_error": { "type": "boolean", "description": "tree-sitter reported a syntax error inside the object; its members may be incomplete" },
    "hash": { "type": "string" }
  },
  "$defs": {
    "clean": { "type": "array", "items": { "type": "string" }, "description": "#if not CLEAN<n> guards around the element: Microsoft's marker for removal in version n" },
    "obsolete": { "type": ["object", "null"], "properties": { "state": { "enum": ["Pending", "Removed", "No"] }, "tag": { "type": ["string", "null"] }, "reason": { "type": ["string", "null"] } } }
  }
}
