{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waldo1001.github.io/waldo.BCObservatory/schemas/overrides-links.json",
  "title": "Hand-made cross-links (data/overrides/links.yaml, D106)",
  "description": "A link a human checked. `from` is a page id, `to` a page id or a Learn URL; the pipeline writes both directions and merges these last, over any generated link with the same target.",
  "type": "object",
  "additionalProperties": false,
  "required": ["links"],
  "properties": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "label", "why", "evidence"],
        "properties": {
          "from": { "type": "string", "pattern": "^(object|change|video|post|topic|feature|hotfix|release)/[A-Za-z0-9_-][A-Za-z0-9/_.#-]*$" },
          "to": { "type": "string", "minLength": 1 },
          "label": { "enum": ["fixes", "documents", "names", "possibly related", "relation unknown"] },
          "why": { "type": "string", "minLength": 1, "maxLength": 200 },
          "evidence": {
            "type": "object", "additionalProperties": false, "required": ["by", "at"],
            "properties": { "by": { "type": "string" }, "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "url": { "type": "string" } }
          }
        }
      }
    }
  }
}
