{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waldo1001.github.io/waldo.BCObservatory/schemas/run-report.json",
  "title": "Nightly run report (data/manifest/_runs/<date>.json); also the heartbeat that keeps the schedule alive",
  "type": "object",
  "required": ["date", "started_at", "finished_at", "status", "pipeline", "guard", "ingest", "plan", "llm", "errors"],
  "additionalProperties": false,
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ok", "partial", "skipped-budget", "aborted", "dry-run"] },
    "pipeline": { "type": "string" },
    "runner": { "type": "object", "additionalProperties": { "type": "string" } },
    "guard": {
      "type": "object", "required": ["decision", "status"],
      "properties": {
        "decision": { "enum": ["go", "skip", "reduced", "disabled"] },
        "status": { "type": "string" },
        "five_hour": { "type": ["number", "null"] },
        "seven_day": { "type": ["number", "null"] },
        "resets_at": { "type": ["string", "null"] },
        "headroom": { "type": ["number", "null"] },
        "factor": { "type": "number" },
        "facts_only": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    },
    "ingest": {
      "type": "object", "required": ["sources", "totals"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "kind", "ok", "counts"],
            "properties": {
              "id": { "type": "string" }, "kind": { "type": "string" }, "ok": { "type": "boolean" },
              "deferred": { "type": "boolean" }, "error": { "type": "string" }, "note": { "type": "string" },
              "duration_ms": { "type": "integer" },
              "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
              "suggestions": { "type": "array" }
            }
          }
        },
        "totals": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    },
    "plan": {
      "type": "object", "required": ["quotas", "work", "executed"],
      "properties": {
        "quotas": { "type": "object", "additionalProperties": { "type": "integer" } },
        "work": { "type": "integer" },
        "executed": { "type": "integer" },
        "skips": { "type": "integer" },
        "quota_use": { "type": "object" },
        "note": { "type": "string" }
      }
    },
    "llm": {
      "type": "object",
      "properties": {
        "calls": { "type": "integer" }, "cache_hits": { "type": "integer" }, "failures": { "type": "integer" },
        "by_model": { "type": "object" },
        "cost_usd": { "type": "number", "description": "API-equivalent dollars spent by this run (claude -p total_cost_usd)" },
        "day_cost_usd": { "type": "number", "description": "this run plus earlier runs on the same date; the weekly cap sums this" },
        "tokens_by_model": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "required": ["calls", "input", "output", "cache_read", "cache_creation", "cost_usd"],
            "properties": {
              "calls": { "type": "integer" }, "input": { "type": "integer" }, "output": { "type": "integer" },
              "cache_read": { "type": "integer" }, "cache_creation": { "type": "integer" }, "cost_usd": { "type": "number" }
            }
          }
        }
      }
    },
    "spend": {
      "type": "object",
      "required": ["night_cap_usd", "week_cap_usd", "today_usd", "week_before_usd", "allowance_usd", "binding", "exhausted"],
      "properties": {
        "night_cap_usd": { "type": "number" }, "week_cap_usd": { "type": "number" },
        "today_usd": { "type": "number" }, "week_before_usd": { "type": "number" },
        "allowance_usd": { "type": "number" }, "binding": { "enum": ["night", "week"] }, "exhausted": { "type": "boolean" }, "override": { "type": "boolean", "description": "caps were replaced for this run with --night-cap/--week-cap" }
      }
    },
    "execution": {
      "type": "object",
      "required": ["stop_reason", "deadline", "items_touched", "stages_run", "advanced", "skipped", "failed_attempts", "failed_final", "no_handler", "quota_charged", "regards", "errors"],
      "properties": {
        "stop_reason": { "enum": ["done", "hard-stop", "llm-calls-max", "spend-cap", "guard-skip", "aborted", "memory"] },
        "deadline": { "type": "string", "format": "date-time" },
        "items_touched": { "type": "integer" }, "advanced": { "type": "integer" }, "skipped": { "type": "integer" },
        "failed_attempts": { "type": "integer" }, "failed_final": { "type": "integer" }, "no_handler": { "type": "integer" }, "held": { "type": "integer" }, "parked": { "type": "integer" }, "parked_left": { "type": "integer" },
        "stages_run": { "type": "object", "additionalProperties": { "type": "integer" } },
        "quota_charged": { "type": "object", "additionalProperties": { "type": "integer" } },
        "regards": { "type": "array", "items": { "type": "object", "required": ["at_calls", "decision", "status"] } },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "leak": {
      "type": "object", "required": ["vault", "findings", "blocked"],
      "properties": {
        "vault": { "enum": ["scanned", "missing", "not-needed"] }, "raw_docs": { "type": "integer" }, "files_scanned": { "type": "integer" },
        "findings": { "type": "integer" }, "blocked": { "type": "boolean" }
      }
    },
    "captions_retried": { "type": "integer" },
    "checkpoints": { "type": "integer" },
    "catch_up": { "type": "string", "description": "catch-up mode was on (no quotas, no caps) until this run date" },
    "code": { "type": "object", "properties": { "version_diffs": { "type": "integer" }, "country_diffs": { "type": "integer" }, "timelines": { "type": "integer" }, "deprecations": { "type": "integer" }, "written": { "type": "integer" }, "docs_objects": { "type": "object" }, "pages": { "type": "object" }, "narratives": { "type": "object" } } },
    "content": { "type": "object", "required": ["pages", "errors"], "properties": { "pages": { "type": "integer" }, "errors": { "type": "integer" } } },
    "roadmap_links": {
      "type": "object", "required": ["units", "stale", "calls", "matched", "rejected", "failed", "stopped"],
      "properties": {
        "units": { "type": "integer" }, "stale": { "type": "integer" }, "calls": { "type": "integer" }, "matched": { "type": "integer" },
        "rejected": { "type": "integer" }, "related": { "type": "integer" }, "failed": { "type": "integer" }, "cost_usd": { "type": "number" },
        "classified": { "type": "integer" }, "unclassified": { "type": "integer" },
        "rejections": { "type": "array", "items": { "type": "string" } }, "stopped": { "type": "string" }, "pages": { "type": "integer" },
        "review": {
          "type": "object", "required": ["candidates", "reviewed", "kept", "dropped", "failed", "stopped"],
          "properties": {
            "candidates": { "type": "integer" }, "reviewed": { "type": "integer" }, "kept": { "type": "integer" }, "dropped": { "type": "integer" },
            "failed": { "type": "integer" }, "cost_usd": { "type": "number" }, "stopped": { "type": "string" }
          }
        }
      }
    },
    "hubs": {
      "type": "object",
      "required": ["topics", "narrated", "refreshed", "failed", "backlog", "stopped"],
      "properties": {
        "topics": { "type": "integer" }, "narrated": { "type": "integer" }, "refreshed": { "type": "integer" },
        "failed": { "type": "integer" }, "backlog": { "type": "integer" }, "stopped": { "type": "string" },
        "reviewed": { "type": "integer" }, "review_fixed": { "type": "integer" }, "review_rejected": { "type": "integer" }, "review_backlog": { "type": "integer" }
      }
    },
    "items_changed": { "type": "integer" },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
