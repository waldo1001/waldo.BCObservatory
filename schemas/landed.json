{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waldo1001.github.io/waldo.BCObservatory/schemas/landed.json",
  "title": "Landed this week (D66): videos and posts published in the days up to the run date",
  "type": "object",
  "required": ["anchor", "days", "items"],
  "properties": {
    "anchor": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "the run date, last day of the window" },
    "days": { "type": "number" },
    "items": {
      "type": "array",
      "items": { "type": "array", "minItems": 4, "items": false, "description": "[media id, v or p, published date, summary stars it links to, title]",
        "prefixItems": [{ "type": "string" }, { "enum": ["v", "p"] }, { "type": "string" }, { "type": "array", "items": { "type": "string" } }, { "type": "string" }] }
    }
  }
}
