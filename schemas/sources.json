{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waldo1001.github.io/waldo.BCObservatory/schemas/sources.json",
  "title": "BC Observatory source registry",
  "type": "object",
  "required": ["version", "sources"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "defaults": { "$ref": "#/$defs/defaults" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "tier": { "enum": ["official", "community"] },
    "backfill": {
      "type": "object", "additionalProperties": false,
      "properties": { "months": { "type": "integer", "minimum": 1, "maximum": 120 }, "all": { "type": "boolean" } }
    },
    "defaults": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "tier": { "$ref": "#/$defs/tier" }, "full_text": { "type": "boolean" },
        "language": { "type": "string", "pattern": "^[a-z]{2}$" }, "backfill": { "$ref": "#/$defs/backfill" },
        "enabled": { "type": "boolean" }
      }
    },
    "author": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string" }, "mvp": { "type": "boolean" }, "github": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
    },
    "consent": {
      "type": "object", "additionalProperties": false, "required": ["evidence", "at"],
      "properties": { "evidence": { "type": "string", "format": "uri" }, "at": { "type": ["string"], "format": "date" }, "note": { "type": "string" } }
    },
    "fetch": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "feed": { "type": "string", "format": "uri" }, "rest": { "type": "string", "format": "uri" }, "scrape": { "type": "string", "format": "uri" },
        "api": { "type": "string", "format": "uri" }, "product_filter": { "type": "string" }, "user_agent": { "enum": ["default", "browser"] },
        "extension": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$", "description": "D85: the marketplace item name, <publisher>.<extension>" }
      }
    },
    "source": {
      "type": "object", "required": ["id", "kind", "name", "url"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "kind": { "enum": ["blog", "youtube", "docs-git", "code-git", "guidelines-git", "roadmap-api", "discovery", "github-pr", "vsmarketplace"] },
        "name": { "type": "string", "minLength": 2 },
        "url": { "type": "string", "format": "uri" },
        "tier": { "$ref": "#/$defs/tier" },
        "author": { "$ref": "#/$defs/author" },
        "language": { "type": "string", "pattern": "^[a-z]{2}$" },
        "full_text": { "type": "boolean" },
        "consent": { "$ref": "#/$defs/consent" },
        "fetch": { "$ref": "#/$defs/fetch" },
        "channel_id": { "type": "string", "pattern": "^UC[A-Za-z0-9_-]{22}$" },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "branch": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "license": { "type": "string" },
        "mode": { "enum": ["links-only", "metadata-only"] },
        "backfill": { "$ref": "#/$defs/backfill" },
        "enabled": { "type": "boolean" },
        "embed": { "type": "boolean", "description": "D60: false is the author's opt-out of the in-page frame and the poster" },
        "notes": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "youtube" } } }, "then": { "required": ["channel_id"] } },
        { "if": { "properties": { "kind": { "enum": ["docs-git", "code-git", "guidelines-git", "github-pr"] } } }, "then": { "required": ["repo"] } },
        { "if": { "properties": { "kind": { "enum": ["blog", "discovery", "roadmap-api", "vsmarketplace"] } } }, "then": { "required": ["fetch"] } },
        { "if": { "properties": { "kind": { "const": "vsmarketplace" } } }, "then": { "properties": { "fetch": { "required": ["api", "extension"] } } } }
      ]
    }
  }
}
