{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waldo1001.github.io/waldo.BCObservatory/schemas/frontmatter.object.json",
  "title": "Frontmatter of an AL object page (content/objects/<type>/<id>.md)",
  "allOf": [
    {
      "$ref": "frontmatter.base.json"
    }
  ],
  "type": "object",
  "required": [
    "object_type",
    "object_id",
    "name",
    "app",
    "first_version",
    "last_version",
    "present_in",
    "obsolete",
    "countries",
    "counts"
  ],
  "properties": {
    "type": {
      "const": "object"
    },
    "object_type": {
      "type": "string"
    },
    "object_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "caption": {
      "type": "string",
      "description": "The object's Caption property when it differs from its name (D65), e.g. Page 8059 \"Service Objects\" captioned \"Subscriptions\"."
    },
    "namespace": {
      "type": [
        "string",
        "null"
      ]
    },
    "app": {
      "type": [
        "string",
        "null"
      ]
    },
    "extends": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_version": {
      "type": "string"
    },
    "last_version": {
      "type": "string"
    },
    "present_in": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_in": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_major": {
      "type": "string",
      "description": "the major whose snapshot the page shows"
    },
    "obsolete": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "state": {
          "enum": [
            "Pending",
            "Removed",
            "No"
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "country layers that replace this object in their newest major"
    },
    "ms_search_form_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Learn items whose ms.search.form names this object"
    },
    "counts": {
      "type": "object",
      "required": [
        "fields",
        "procedures",
        "events",
        "subscribers"
      ],
      "properties": {
        "fields": {
          "type": "integer"
        },
        "procedures": {
          "type": "integer"
        },
        "events": {
          "type": "integer"
        },
        "subscribers": {
          "type": "integer"
        }
      }
    },
    "country": {
      "type": "string",
      "description": "a country's own object (D52): the country layer it belongs to, uppercase; absent for W1 and first-party app objects"
    }
  }
}
