{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waldo1001.github.io/waldo.BCObservatory/schemas/frontmatter.hotfix.json",
  "title": "Frontmatter of a hotfix list page (content/hotfixes/<update>.md, D106)",
  "allOf": [{ "$ref": "frontmatter.base.json" }],
  "type": "object",
  "required": ["update", "major", "url", "entry_count", "entry_ids"],
  "properties": {
    "type": { "const": "hotfix" },
    "update": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "major": { "type": "string", "pattern": "^\\d+$" },
    "kb": { "type": ["string", "null"] },
    "url": { "type": "string" },
    "month": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}$" },
    "application_build": { "type": ["string", "null"] },
    "platform_build": { "type": ["string", "null"] },
    "entry_count": { "type": "integer", "minimum": 1 },
    "areas": { "type": "object", "additionalProperties": { "type": "integer" } },
    "countries": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
    "entry_ids": { "type": "array", "items": { "type": "string", "pattern": "^\\d{5,8}$" }, "description": "every entry's ID, in page order (search tags; rows are anchored by it)" }
  }
}
