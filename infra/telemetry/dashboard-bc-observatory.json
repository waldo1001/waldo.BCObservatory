  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8fa2fd37-f97e-4b86-a8ac-e30393a52693"
      },
      "text": "// 1. Daily trend: calls, sessions, unique installs\nObs\n| summarize calls = count(), sessions = dcount(session_Id), users = dcountif(user_Id, isnotempty(user_Id))\n  by bin(timestamp, 1d)\n| order by timestamp asc\n| render timechart",
      "id": "52452014-8f5b-47db-951a-964e3193a4b4",
      "usedVariables": [
        "Obs"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8fa2fd37-f97e-4b86-a8ac-e30393a52693"
      },
      "text": "// 2. Per tool: volume, reach, quality, speed\nObs\n| summarize calls = count(), users = dcount(user_Id),\n            nomatchPct = round(100.0 * countif(outcome == \"nomatch\") / count(), 1),\n            notfoundPct = round(100.0 * countif(outcome == \"notfound\") / count(), 1),\n            errorPct = round(100.0 * countif(outcome == \"error\") / count(), 1),\n            p50ms = percentile(ms, 50), p95ms = percentile(ms, 95)\n  by tool\n| order by calls desc",
      "id": "7e493afc-a90a-49ad-9d35-f7b9cfe1d1ba",
      "usedVariables": [
        "Obs"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8fa2fd37-f97e-4b86-a8ac-e30393a52693"
      },
      "text": "// 3. Which MCP clients (Claude Code, VS Code, Cursor, ...)\nObs\n| summarize sessions = dcount(session_Id), users = dcount(user_Id), calls = count() by client\n| order by users desc",
      "id": "ca0c67d8-7342-47e7-bee0-22a29651b511",
      "usedVariables": [
        "Obs"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8fa2fd37-f97e-4b86-a8ac-e30393a52693"
      },
      "text": "// 7. New vs returning installs per week\nObs\n| where isnotempty(user_Id)\n| summarize firstSeen = min(timestamp), weeks = make_set(startofweek(timestamp)) by user_Id\n| mv-expand week = weeks to typeof(datetime)\n| summarize new = countif(startofweek(firstSeen) == week), returning = countif(startofweek(firstSeen) < week) by week\n| order by week asc",
      "id": "dbeb5ad0-3b49-4e1c-b80f-cf2be7020ea9",
      "usedVariables": [
        "Obs"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8fa2fd37-f97e-4b86-a8ac-e30393a52693"
      },
      "text": "// 6. Session depth: one-shot pokes vs real use\nObs\n| summarize calls = count() by session_Id\n| summarize sessions = count() by depth = case(calls == 1, \"1\", calls <= 3, \"2-3\", calls <= 10, \"4-10\", \"11+\")\n| order by depth asc",
      "id": "f98073f3-d346-4d6f-8746-11896fede117",
      "usedVariables": [
        "Obs"
      ]
    },
    {
      "id": "7c3e3f4b-9fc3-4eec-86f0-94f68bd9d9cc",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8fa2fd37-f97e-4b86-a8ac-e30393a52693"
      },
      "text": "// 0. Base: put this on top of every query below\nlet obs = customEvents\n| where timestamp between (_startTime .. _endTime) and name == \"Obs.ToolCall\"\n| extend tool = tostring(customDimensions.tool), outcome = tostring(customDimensions.outcome),\n         client = tostring(customDimensions.client), clientVersion = tostring(customDimensions.clientVersion),\n         mcpVersion = tostring(customDimensions.mcpVersion), ms = todouble(customMeasurements.ms)\n| where client != \"release-check\";\nobs",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "8fa2fd37-f97e-4b86-a8ac-e30393a52693"
      },
      "text": "// 8. Unique users per day (D111, MCP 0.12.0 and later send user_Id)\nObs\n| where isnotempty(user_Id)\n| summarize users = dcount(user_Id) by day = bin(timestamp, 1d)\n| order by day asc",
      "id": "3b1f6c2e-8d4a-4f0e-9a51-7c2d5e8b9f10",
      "usedVariables": [
        "Obs"
      ]
    }
  ],
  "embeddedApps": []
}
