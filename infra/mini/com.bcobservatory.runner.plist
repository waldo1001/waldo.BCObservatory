<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- System LaunchDaemon: bcobs never logs in, so a LaunchAgent or pm2 startup would never start. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bcobservatory.runner</string>
  <key>UserName</key><string>bcobs</string>
  <key>GroupName</key><string>staff</string>
  <key>ProgramArguments</key>
  <array><string>/Users/bcobs/actions-runner/run.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/bcobs/actions-runner</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/bcobs</string>
    <key>USER</key><string>bcobs</string>
    <key>LANG</key><string>en_US.UTF-8</string>
    <key>TZ</key><string>Europe/Brussels</string>
    <key>PATH</key><string>/Users/bcobs/.local/bin:/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/bcobs/observatory/logs/runner.out.log</string>
  <key>StandardErrorPath</key><string>/Users/bcobs/observatory/logs/runner.err.log</string>
</dict>
</plist>
