---
import { getCollection } from "astro:content";
import Page from "../../../layouts/Page.astro";
import EvidenceList from "../../../components/EvidenceList.astro";
import VersionTimeline from "../../../components/VersionTimeline.astro";
import Neighbourhood from "../../../components/Neighbourhood.astro";
import OneHop from "../../../components/OneHop.astro";
import { siteLinks } from "../../../lib/links";
import { objectSystem, trimBody } from "../../../lib/page";
import { markMembers, objectHistory } from "../../../lib/versions";
import type { Lookup } from "../../../lib/relations";
export async function getStaticPaths() {
  const all = await getCollection("objects");
  // relations name objects by type/id (or type/lower-cased name): one lookup shared by every page (D45)
  const byKey = new Map<string, Lookup>();
  // only W1 and first-party app pages: a country's own object shares its id with other countries (D52)
  for (const e of all) if (!e.data.country) byKey.set(`${e.data.object_type}/${e.data.object_id ?? String(e.data.name).toLowerCase()}`, { pk: e.id, title: String(e.data.title), system: objectSystem(e.data.namespace), type: String(e.data.object_type) });
  const lookup = (k: string) => byKey.get(k) ?? null;
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry, lookup } }));
}
const { entry, lookup } = Astro.props;
const base = import.meta.env.BASE_URL;
const fm = entry.data;
const history = objectHistory(entry.id);
// the timeline component replaces the markdown's short "Across versions" list
const html = markMembers(trimBody(siteLinks(entry.rendered?.html ?? "", base, `objects/${entry.id}`)), history)
  .replace(/<h2 id="across-versions">[\s\S]*?(?=<h2|$)/, "");
const c = fm.counts ?? {};
const stats = [
  ...(c.fields ? [{ n: c.fields, label: "fields", href: "#fields" }] : []),
  ...(c.procedures ? [{ n: c.procedures, label: "procedures", href: "#procedures" }] : []),
  ...(c.events ? [{ n: c.events, label: "events", href: "#events-published" }] : []),
  ...(fm.countries?.length ? [{ n: fm.countries.length, label: "countries replace it", href: "#countries-that-replace-it" }] : []),
  ...(fm.relations?.referenced_by ? [{ n: fm.relations.referenced_by, label: "fields reference it", href: "#referenced-by" }] : []),
  ...(fm.relations?.event_subscribers ? [{ n: fm.relations.event_subscribers, label: "event subscribers", href: "#events-published" }] : []),
];
const objectKey = `${fm.object_type}/${fm.object_id ?? String(fm.name).toLowerCase()}`;
const learn = (fm.evidence ?? []).filter((e: any) => e.kind === "learn").map((e: any) => ({ url: String(e.url), title: String(e.title) }));
const src = (fm.evidence ?? []).find((e: any) => e.kind === "code");
---
<Page fm={fm} kind={String(fm.object_type)} path={`objects/${entry.id}`} section="objects"
  crumbs={[{ label: "AL objects", href: `${base}objects/` }, { label: `${fm.object_type}s`, href: `${base}objects/${fm.object_type}/` }]}
  ns={[fm.country ? `${fm.country} country layer` : fm.app, fm.namespace].filter(Boolean).join(" · ")} summary={null} stats={stats}
  context={src ? { label: "Source on GitHub", href: src.url } : undefined} connections={false}>
  <VersionTimeline presentIn={fm.present_in ?? []} changedIn={fm.changed_in ?? []} history={history} obsolete={fm.obsolete} />
  <Neighbourhood objectKey={objectKey} major={String(fm.source_major)} title={String(fm.title)} system={objectSystem(fm.namespace)} lookup={lookup} learn={learn} />
  <div class="prose" set:html={html} />
  <EvidenceList evidence={fm.evidence ?? []} noun="sources" />
  <OneHop slot="locator" objectKey={objectKey} major={String(fm.source_major)} />
</Page>
