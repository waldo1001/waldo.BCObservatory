---
import { getCollection } from "astro:content";
import Page from "../../../layouts/Page.astro";
import { siteLinks } from "../../../lib/links";
import { trimBody } from "../../../lib/page";
export async function getStaticPaths() {
  return (await getCollection("digests")).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const fm = entry.data;
const html = trimBody(siteLinks(entry.rendered?.html ?? "", base, `digests/${entry.id}`)).replace(`href="../../rss.xml"`, `href="${base}rss.xml"`);
---
<Page fm={fm} kind="weekly digest" path={`digests/${entry.id}`} section="digests" crumbs={[{ label: "Weekly", href: `${base}digests/` }]}
  context={{ label: "RSS", href: `${base}rss.xml` }}>
  <div class="prose" set:html={html} />
</Page>
