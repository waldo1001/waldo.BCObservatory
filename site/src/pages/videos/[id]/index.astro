---
import { getCollection } from "astro:content";
import Page from "../../../layouts/Page.astro";
import { siteLinks } from "../../../lib/links";
import { trimBody } from "../../../lib/page";
export async function getStaticPaths() {
  return (await getCollection("videos")).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const fm = entry.data;
const html = trimBody(siteLinks(entry.rendered?.html ?? "", base, `videos/${entry.id}`));
---
<Page fm={fm} kind="video" path={`videos/${entry.id}`} section="videos" crumbs={[{ label: "Videos", href: `${base}videos/` }]}
  context={{ label: "Watch on YouTube", href: `https://www.youtube.com/watch?v=${entry.id}` }}>
  <div class="prose" set:html={html} />
</Page>
