---
import { getCollection } from "astro:content";
import List from "../../layouts/List.astro";
import Badges from "../../components/Badges.astro";
const base = import.meta.env.BASE_URL;
const videos = (await getCollection("videos")).sort((a, b) => String(b.data.published_at ?? "").localeCompare(String(a.data.published_at ?? "")));
---
<List section="videos" title="Videos · BC Observatory" description="Business Central videos as structured, timestamped evidence.">
  <p class="eyebrow">Videos</p>
  <h1>{videos.length} videos</h1>
  <p class="lede">Summaries, chapters, features with verified status quotes and timestamped links. Machine-generated pages carry a badge until Opus reviews them. Agents: <a href={`${base}videos/llms.txt`}>llms.txt</a>.</p>
  <ul class="list">
    {videos.map((v) => (
      <li>
        <a href={`${base}videos/${v.id}/`}>{v.data.title}</a>
        <span class="row-meta"><Badges tier={v.data.tier} review={v.data.review?.state} /></span>
        <div class="meta">{v.data.source_name} · {String(v.data.published_at ?? "").slice(0, 10)}</div>
        <div>{v.data.summary}</div>
      </li>
    ))}
  </ul>
</List>
