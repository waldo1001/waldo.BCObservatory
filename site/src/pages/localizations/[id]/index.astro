---
import { getCollection } from "astro:content";
import Page from "../../../layouts/Page.astro";
import CountryDiff from "../../../components/CountryDiff.astro";
import { siteLinks, wrapTables } from "../../../lib/links";
import { trimBody } from "../../../lib/page";
export async function getStaticPaths() {
  return (await getCollection("localizations")).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const fm = entry.data;
// the country diff component replaces the markdown's summary table of changed W1 objects
const html = trimBody(siteLinks(entry.rendered?.html ?? "", base, `localizations/${entry.id}`))
  .replace(/<h2 id="w1-objects-this-country-changes">[\s\S]*?(?=<h2|$)/, "");
---
<Page fm={fm} kind={`localization · BC${fm.version}`} path={`localizations/${entry.id}`} section="localizations"
  stats={[{ n: fm.added_objects ?? 0, label: "objects of its own", href: "#objects-of-its-own" }, { n: fm.replaced_objects ?? 0, label: "W1 objects changed", href: "#country-diff" }]} crumbs={[{ label: "Localizations", href: `${base}localizations/` }]}>
  <CountryDiff country={String(fm.country)} version={String(fm.version)} base={base} />
  <div class="prose" set:html={wrapTables(html)} />
</Page>
