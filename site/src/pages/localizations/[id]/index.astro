---
import { getCollection } from "astro:content";
import Page from "../../../layouts/Page.astro";
import { siteLinks } from "../../../lib/links";
import { trimBody } from "../../../lib/page";
export async function getStaticPaths() {
  return (await getCollection("localizations")).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const fm = entry.data;
const html = trimBody(siteLinks(entry.rendered?.html ?? "", base, `localizations/${entry.id}`));
---
<Page fm={fm} kind={`localization · BC${fm.version}`} path={`localizations/${entry.id}`} section="localizations"
  stats={[{ n: fm.added_objects ?? 0, label: "objects of its own", href: "#objects-of-its-own" }, { n: fm.replaced_objects ?? 0, label: "W1 objects changed", href: "#w1-objects-this-country-changes" }]} crumbs={[{ label: "Localizations", href: `${base}localizations/` }]}>
  <div class="prose" set:html={html} />
</Page>
