---
import { getCollection } from "astro:content";
import Page from "../../../layouts/Page.astro";
import { siteLinks } from "../../../lib/links";
import { trimBody } from "../../../lib/page";
export async function getStaticPaths() {
  return (await getCollection("changes")).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const fm = entry.data;
// the merge line sits between the title and the summary quote in the markdown; the layout draws both
const html = trimBody(siteLinks(entry.rendered?.html ?? "", base, `changes/${entry.id}`)).replace(/^\s*<blockquote>[\s\S]*?<\/blockquote>\s*/, "");
const stats = [
  { n: fm.files?.count ?? 0, label: "files" },
  { n: fm.files?.al ?? 0, label: "AL files" },
  { n: (fm.objects_touched ?? []).length, label: "objects" },
];
---
<Page fm={fm} kind={`code change · ${fm.change_kind}${fm.breaking ? " · breaking" : ""}`} path={`changes/${entry.id}`} section="changes"
  crumbs={[{ label: "Code changes", href: `${base}changes/` }]} stats={stats}
  context={{ label: `Pull request #${fm.number}`, href: fm.url }}>
  <div class="prose" set:html={html} />
</Page>
