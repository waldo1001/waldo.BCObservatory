---
import { getCollection } from "astro:content";
import List from "../../layouts/List.astro";
const base = import.meta.env.BASE_URL;
const all = await getCollection("topics");
const roots = all.filter((t) => !t.data.parent).sort((a, b) => a.id.localeCompare(b.id));
const byParent = new Map<string, typeof all>();
for (const t of all) if (t.data.parent) byParent.set(t.data.parent, [...(byParent.get(t.data.parent) ?? []), t]);
const href = (t: (typeof all)[number]) => `${base}topics/${t.id}/`;
---
<List section="topics" title="Topics · BC Observatory" description="Topic hubs seeded from the Microsoft Learn TOCs.">
  <p class="eyebrow">Topics</p>
  <h1>{all.length} topics</h1>
  <p class="lede">Hubs seeded from the Microsoft Learn TOCs. Each lists what Learn documents in that section and links out to Learn. Agents: <a href={`${base}topics/llms.txt`}>llms.txt</a>.</p>
  {roots.map((r) => (
    <section>
      <h2><a href={href(r)}>{r.data.title}</a> <span class="meta">{r.data.coverage?.learn} pages</span></h2>
      <ul>{(byParent.get(r.data.id) ?? []).map((c) => <li><a href={href(c)}>{c.data.title}</a> <span class="meta">{c.data.coverage?.learn}</span></li>)}</ul>
    </section>
  ))}
</List>
