---
import { getCollection } from "astro:content";
import Page from "../../../layouts/Page.astro";
import EvidenceList from "../../../components/EvidenceList.astro";
import { siteLinks } from "../../../lib/links";
import { trimBody } from "../../../lib/page";
export async function getStaticPaths() {
  const all = await getCollection("topics");
  const titles = new Map(all.map((e) => [`topic/${e.id}`, String(e.data.title)]));
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry, parentTitle: titles.get(entry.data.parent) ?? null } }));
}
const { entry, parentTitle } = Astro.props;
const base = import.meta.env.BASE_URL;
const fm = entry.data;
const html = trimBody(siteLinks(entry.rendered?.html ?? "", base, `topics/${entry.id}`));
const learn = (fm.evidence ?? []).filter((e: any) => e.kind === "learn");
const L = fm.links ?? {};
const crumbs = [{ label: "Topics", href: `${base}topics/` }, ...(fm.parent && parentTitle ? [{ label: parentTitle, href: `${base}topics/${String(fm.parent).replace(/^topic\//, "")}/` }] : [])];
const stats = [
  { n: fm.coverage?.learn ?? learn.length, label: "Learn pages", href: "#evidence" },
  ...(fm.children?.length ? [{ n: fm.children.length, label: "subtopics", href: "#subtopics" }] : []),
  ...(L.videos?.length ? [{ n: L.videos.length, label: "videos" }] : []),
  ...(L.features?.length ? [{ n: L.features.length, label: "roadmap features" }] : []),
  ...(L.objects?.length ? [{ n: L.objects.length, label: "AL objects" }] : []),
];
---
<Page fm={fm} kind="topic hub" path={`topics/${entry.id}`} section="topics" crumbs={crumbs} stats={stats}>
  <div class="prose" set:html={html} />
  <EvidenceList evidence={learn} title="What Learn documents here" noun="Learn pages" total={fm.coverage?.learn} />
</Page>
