---
import { getCollection } from "astro:content";
import { posix } from "node:path";
import Base from "../../../layouts/Base.astro";
export async function getStaticPaths() {
  return (await getCollection("topics")).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
// the markdown links topic pages relatively (works on GitHub); on the site each page is a directory URL
const html = (entry.rendered?.html ?? "").replace(/href="([^":#?]+)\.md"/g, (_m: string, rel: string) =>
  `href="${base}topics/${posix.normalize(posix.join(posix.dirname(entry.id), rel))}/"`);
---
<Base title={`${entry.data.title} · BC Observatory`} description={entry.data.summary} markdown={`${base}topics/${entry.id}.md`}>
  <p class="eyebrow">Topic · {entry.data.system ?? "no system"} · <a href={`${base}topics/${entry.id}.md`}>markdown</a></p>
  <article set:html={html} />
</Base>
