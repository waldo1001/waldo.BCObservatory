---
import List from "../../layouts/List.astro";
const base = import.meta.env.BASE_URL;
---
<List title="Search · BC Observatory" description="Search every page of BC Observatory." crumb="Search">
  <div class="search" data-base={base}>
    <h1>Search</h1>
    <form role="search">
      <label for="sq" class="skip">Search query</label>
      <input id="sq" name="q" type="search" placeholder="table 18, Sales-Post, Belgium, e-documents" autocomplete="off" />
      <label for="st" class="skip">Page type</label>
      <select id="st" name="type">
        <option value="">all types</option>
        <option value="topic">topic hubs</option><option value="object">AL objects</option><option value="feature">roadmap features</option>
        <option value="localization">localizations</option><option value="video">videos</option><option value="post">community posts</option>
      </select>
    </form>
    <p class="status meta" aria-live="polite"></p>
    <ul class="rows results"></ul>
    <p class="meta">Agents use the same index through the MCP server: <code>npx bc-observatory</code>.</p>
  </div>
</List>
<script>
  import { mountSearch } from "../../scripts/search";
  const el = document.querySelector<HTMLElement>(".search");
  if (el) mountSearch(el);
</script>
<style>
  .search form { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 12px; }
  .search input, .search select { background: var(--surface); color: var(--text); border: 1px solid var(--line-strong); border-radius: var(--r-card); font: 400 16px var(--font-ui); padding: 10px 12px; min-height: 44px; }
  .search input { flex: 1 1 320px; }
  .search :global(.results li) { display: grid; gap: 4px; }
  .search :global(.results p) { margin: 0; }
</style>
