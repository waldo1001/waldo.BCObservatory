---
/** A first-party app (D65, discovery spec 3.6): its objects by type, the hubs that document them, media, roadmap. */
import { getCollection } from "astro:content";
import Page from "../../../layouts/Page.astro";
import EvidenceList from "../../../components/EvidenceList.astro";
import { siteLinks } from "../../../lib/links";
import { trimBody } from "../../../lib/page";
export async function getStaticPaths() {
  return (await getCollection("apps")).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const fm = entry.data;
const html = trimBody(siteLinks(entry.rendered?.html ?? "", base, `apps/${entry.id}`));
const c = fm.counts ?? {};
const stats = [
  { n: c.objects ?? 0, label: "AL objects", href: "#objects" },
  ...(c.hubs ? [{ n: c.hubs, label: "Learn hubs", href: "#what-learn-documents-it" }] : []),
  ...(c.videos ? [{ n: c.videos, label: "videos", href: "#videos-and-posts" }] : []),
  ...(c.posts ? [{ n: c.posts, label: "posts", href: "#videos-and-posts" }] : []),
  ...((fm.present_in ?? []).length ? [{ n: `BC${fm.present_in[0]}${fm.present_in.length > 1 ? `-${fm.present_in.at(-1)}` : ""}`, label: "versions" }] : []),
];
const src = (fm.evidence ?? []).find((e: any) => e.kind === "code");
---
<Page fm={fm} kind="first-party app" path={`apps/${entry.id}`} section="apps" crumbs={[{ label: "Apps", href: `${base}apps/` }]}
  ns={fm.namespace_root ?? undefined} stats={stats} context={src ? { label: "Source on GitHub", href: src.url } : undefined}>
  <div class="prose" set:html={html} />
  <EvidenceList evidence={fm.evidence ?? []} noun="sources" />
</Page>
