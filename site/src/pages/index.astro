---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Galaxy from "../components/Galaxy.astro";
import Badges from "../components/Badges.astro";
import { questions } from "../lib/questions";
import { pageSystem, systemLabel } from "../lib/page";
const [topics, features, objects, localizations, videos, posts, digests, sources, changes] = await Promise.all(
  ["topics", "features", "objects", "localizations", "videos", "posts", "digests", "sources", "changes"].map((c) => getCollection(c as any)),
);
const base = import.meta.env.BASE_URL;
const repo = "https://github.com/waldo1001/waldo.BCObservatory";
const digest = [...digests].sort((a, b) => b.id.localeCompare(a.id))[0];
// newly lit: the newest videos and posts
const dated = [...videos.map((e) => ({ e, dir: "videos" })), ...posts.map((e) => ({ e, dir: "posts" }))]
  .filter(({ e }) => e.data.published_at).sort((a, b) => String(b.e.data.published_at).localeCompare(String(a.e.data.published_at))).slice(0, 6);
const n = (x: number) => x.toLocaleString("en");
const sections = [
  { id: "topics", label: "Topic hubs", count: topics.length, text: "Seeded from the Microsoft Learn tables of contents. What Learn documents per topic, linked to Learn." },
  { id: "objects", label: "AL objects", count: objects.length, text: "Every W1 and first-party app object of BC28 to BC30, from the code: fields, events, procedures, versions, countries." },
  { id: "localizations", label: "Localizations", count: localizations.length, text: "What each country layer adds to or changes in W1, down to the field." },
  { id: "features", label: "Roadmap", count: features.length, text: "Business Central on the Microsoft 365 roadmap, with the videos and Learn pages that cover each feature." },
  { id: "videos", label: "Videos", count: videos.length, text: "Sessions as timestamped evidence: chapters, key points, quotes that deep-link to the second." },
  { id: "posts", label: "Community posts", count: posts.length, text: "Blog posts as derived summaries with short quotes and a link to the original." },
  { id: "digests", label: "Weekly", count: digests.length, text: "What changed each week, with a deprecation radar. Also as RSS." },
  { id: "sources", label: "Sources", count: sources.length, text: "Each blog and channel with its footprint and flight path through the galaxy." },
  { id: "changes", label: "Code changes", count: changes.length, text: "Merged pull requests of Microsoft's BCApps that touch AL source, linked to the objects they changed." },
];
---
<Base title="BC Observatory" section="home" description="An agent-first, cross-referenced knowledge base of Microsoft Dynamics 365 Business Central, rebuilt every night.">
  <main>
    <h1 class="skip">BC Observatory</h1>
    <div id="galaxy"><Galaxy height="calc(100svh - var(--hdr-h, 72px))" questions={questions(base)} /></div>
    <p class="wrap meta g-help">Systems are domains, placed next to the ones they share the most links with. Stars are hubs on their Learn table of contents and the most connected AL objects in their namespace plots, plus roadmap features, localizations and sources. Click a system to fly in, a star for its connections and where they cross into other systems. Type in the search box to light up matching stars; Enter opens the full results. Esc goes back out; the arrow keys step through systems, or from star to star. "list view" shows the same as a table. Every page's side column shows where it sits here.</p>

    <section class="wrap block" aria-labelledby="lit">
      <h2 class="section-title" id="lit">Newly lit {digest && <small><a href={`${base}digests/${digest.id}/`}>{digest.id}</a></small>}</h2>
      {digest && <p class="meta">{digest.data.summary}</p>}
      <ul class="rows">
        {dated.map(({ e, dir }) => {
          const sys = pageSystem(e.data);
          return (
            <li>
              <a class="row-title" href={`${base}${dir}/${e.id}/`}>{e.data.title}</a>
              <span class="row-meta">
                <span class="mono-meta">{String(e.data.published_at).slice(0, 10)}</span>
                <span class="type-label">{dir === "videos" ? "video" : "community post"}</span>
                {sys && <span class="chip-sys" style={`--dot: var(--sys-${sys})`}>{systemLabel(sys)}</span>}
                <Badges tier={e.data.tier} />
                <span class="mono-meta">{e.data.source_name ?? ""}</span>
              </span>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="wrap block" aria-labelledby="sections">
      <h2 class="section-title" id="sections">Sections</h2>
      <ul class="cards">
        {sections.map((s) => <li><a href={`${base}${s.id}/`}><b>{s.label}</b><span class="mono-meta">{n(s.count)}</span><p>{s.text}</p></a></li>)}
      </ul>
    </section>

    <section class="wrap block agents" aria-labelledby="agents">
      <h2 class="section-title" id="agents">About</h2>
      <p class="lead">
        Business Central from every angle at once: Microsoft Learn, the actual code, the roadmap, the sessions and the community
        blogs, woven into one knowledge base. Every claim points at its evidence. Built for AI agents first, and for you.
      </p>
      <p>Who made this, why, how it runs and who it is for: <a href={`${base}about/`}>About BC Observatory</a>. For your agent: <a href={`${base}mcp/`}>the MCP server and the Claude Code plugin</a>, what to ask and how to install.</p>
    </section>
  </main>
</Base>
<style>
  .g-help { margin-top: 10px; }
  .block { margin-top: var(--section-gap-home); }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .cards a { display: grid; grid-template-columns: 1fr auto; gap: 4px 8px; height: 100%; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface); color: var(--text); text-decoration: none; }
  .cards a:hover { border-color: var(--line-strong); }
  .cards b { font-size: 17px; }
  .cards p { grid-column: 1 / -1; margin: 0; color: var(--muted); font-size: 14px; }
</style>
