---
import { getCollection } from "astro:content";
import Page from "../../../layouts/Page.astro";
import FlightPath from "../../../components/FlightPath.astro";
import { siteLinks } from "../../../lib/links";
import { trimBody } from "../../../lib/page";
import { sourceIcon } from "../../../lib/preview";
export async function getStaticPaths() {
  const items = [...(await getCollection("posts")).map((e) => ({ e, dir: "posts", src: e.data.source_id })), ...(await getCollection("videos")).map((e) => ({ e, dir: "videos", src: e.data.channel })),
    // D61: a repository's changes, dated by their merge
    ...(await getCollection("changes")).map((e) => ({ e: { ...e, data: { ...e.data, published_at: e.data.merged_at } }, dir: "changes", src: e.data.source_id }))];
  return (await getCollection("sources")).map((entry) => ({
    params: { id: entry.id },
    props: { entry, stops: items.filter((i) => i.src === entry.data.source_id).map(({ e, dir }) => ({
      date: e.data.published_at ? String(e.data.published_at).slice(0, 10) : null, title: String(e.data.title), href: `${dir}/${e.id}/`,
      systems: [e.data.system, ...(e.data.systems ?? [])].filter((x, i, a) => x && a.indexOf(x) === i), tags: (e.data.tags ?? []).map(String),
    })).sort((a, b) => String(a.date).localeCompare(String(b.date))) },
  }));
}
const { entry, stops } = Astro.props;
const base = import.meta.env.BASE_URL;
const fm = entry.data;
// the flight path component replaces the markdown's per-quarter list and its most recent items
const html = trimBody(siteLinks(entry.rendered?.html ?? "", base, `sources/${entry.id}`))
  .replace(/<h2 id="flight-path">[\s\S]*?(?=<h2|$)/, "")
  .replace(/<h2 id="most-recent">[\s\S]*?(?=<h2|<p>Source:|$)/, "");
---
<Page fm={fm} kind={fm.kind === "youtube" ? "channel" : fm.kind === "github-pr" ? "repository" : "blog"} path={`sources/${entry.id}`} section="sources" crumbs={[{ label: "Sources", href: `${base}sources/` }]}
  stats={[{ n: fm.item_count, label: fm.kind === "youtube" ? "videos" : fm.kind === "github-pr" ? "changes" : "posts" }, ...(fm.first_item ? [{ n: String(fm.first_item).slice(0, 7), label: "first item" }] : [])]}
  context={{ label: "Visit", href: fm.url }} icon={sourceIcon(fm.source_id)}>
  <div class="prose" set:html={html} />
  <FlightPath stops={stops.map((s) => ({ ...s, href: `${base}${s.href}` }))} />
</Page>
