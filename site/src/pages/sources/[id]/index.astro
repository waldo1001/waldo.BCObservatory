---
import { getCollection } from "astro:content";
import Page from "../../../layouts/Page.astro";
import { siteLinks } from "../../../lib/links";
import { trimBody } from "../../../lib/page";
export async function getStaticPaths() {
  return (await getCollection("sources")).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const fm = entry.data;
const html = trimBody(siteLinks(entry.rendered?.html ?? "", base, `sources/${entry.id}`));
---
<Page fm={fm} kind={fm.kind === "youtube" ? "channel" : "blog"} path={`sources/${entry.id}`} section="sources" crumbs={[{ label: "Sources", href: `${base}sources/` }]}
  stats={[{ n: fm.item_count, label: fm.kind === "youtube" ? "videos" : "posts" }, ...(fm.first_item ? [{ n: String(fm.first_item).slice(0, 7), label: "first item" }] : [])]}
  context={{ label: "Visit", href: fm.url }}>
  <div class="prose" set:html={html} />
</Page>
