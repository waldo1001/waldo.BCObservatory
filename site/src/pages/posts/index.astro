---
import { getCollection } from "astro:content";
import List from "../../layouts/List.astro";
import { countLabel, section } from "../../../../pipeline/lib/sections";
import MediaList from "../../components/MediaList.astro";
const base = import.meta.env.BASE_URL;
// the h1 counts the collection; the rows, pills and title list come from the media records (D91)
const all = await getCollection("posts");
---
<List section="posts" title={`${section("posts").name} · BC Observatory`} description="Business Central blog posts as derived evidence.">
  <p class="eyebrow">{section("posts").name}</p>
  <h1>{countLabel("posts", all.length)}</h1>
  <p class="lede">Summaries, key points and short quotes from Business Central blogs, linking to the original. Agents: <a href={`${base}posts/llms.txt`}>llms.txt</a>.</p>
  <MediaList type="post" noun="posts" />
</List>
