---
import { getCollection } from "astro:content";
import Page from "../../../layouts/Page.astro";
import { siteLinks } from "../../../lib/links";
import { trimBody } from "../../../lib/page";
export async function getStaticPaths() {
  return (await getCollection("posts")).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const fm = entry.data;
const html = trimBody(siteLinks(entry.rendered?.html ?? "", base, `posts/${entry.id}`));
const original = (fm.evidence ?? []).find((e: any) => e.kind === "blog")?.url ?? fm.url;
---
<Page fm={fm} kind="community post" path={`posts/${entry.id}`} section="posts"
  crumbs={[{ label: "Posts", href: `${base}posts/` }, ...(fm.source_id ? [{ label: String(fm.source_name ?? fm.source_id), href: `${base}sources/${fm.source_id}/` }] : [])]}
  context={original ? { label: `Read the original${fm.source_name ? ` on ${fm.source_name}` : ""}`, href: original } : undefined}>
  <div class="prose" set:html={html} />
</Page>
