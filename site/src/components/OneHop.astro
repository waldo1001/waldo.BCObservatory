---
/**
 * The one-hop diagram in an object page's side column (D66 phase 3): the object, the top neighbour of each ring (at
 * most 5), the number of links, all one link into the neighbourhood explorer. Inline SVG at build time, no script, a
 * few hundred bytes: edges share one path per line style, nodes are bare paths, the styles are global under `.hop`.
 */
import { oneHop, type CodeRing } from "../lib/relations";
import { edgeStyle } from "../scripts/explorer-core";
interface Props { objectKey: string; major: string }
const { objectKey, major } = Astro.props;
const base = import.meta.env.BASE_URL;
const h = oneHop(objectKey, major);
// right = it points there, left = it is pointed at; ring 2 below
const AT: Record<CodeRing, [number, number]> = { relates: [112, 64], referenced: [18, 64], pages: [100, 104], extensions: [65, 116], subscribers: [30, 104] };
const paths = new Map<string, string>();
for (const t of h?.top ?? []) { const [x, y] = AT[t.ring], s = edgeStyle(t.kind); paths.set(s, `${paths.get(s) ?? ""}M65 64L${x} ${y}`); }
const href = h ? `${base}neighbourhood/?o=${encodeURIComponent(objectKey).replace(/%2F/g, "/")}&s=${h.system}&v=${major}` : "";
---
{h && (
  <section class="hop">
    <h2>Neighbourhood</h2>
    <a href={href}><svg viewBox="0 0 130 130" aria-hidden="true">{[...paths].map(([s, d]) => <path class={s} d={d} />)}<path class="c" d="M56 55h18v18h-18z" style={`stroke:var(--sys-${h.system})`} />{h.top.map((t) => <path d={`M${AT[t.ring][0] - 5} ${AT[t.ring][1] - 5}h10v10h-10z`} style={`fill:var(--sys-${t.system})`} />)}</svg>{h.links} links in the explorer →</a>
  </section>
)}
<style is:global>
  .hop a { display: inline-grid; gap: 4px; font: 500 12px var(--font-mono); }
  .hop svg { display: block; width: 130px; height: 130px; border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--g-bg); }
  .hop a:hover svg { border-color: var(--line-strong); }
  .hop path[class] { fill: none; stroke: var(--nb-edge); stroke-width: 1; }
  .hop .dashed { stroke-dasharray: 4 3; }
  .hop .dotted { stroke-dasharray: 1 3; stroke-linecap: round; }
  .hop .double { stroke-width: 3; }
  .hop .dashdot { stroke-dasharray: 6 2 2 2; }
  .hop path.c { fill: var(--nb-centre); stroke-width: 2; stroke-dasharray: none; }
</style>
