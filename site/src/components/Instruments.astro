---
/**
 * The instruments strip (D90): one card per instrument with last night's number, on the home page under the galaxy and
 * on /objects/#instruments. Cards come from site/src/lib/instruments.ts; a card whose data is missing is not drawn.
 * Styles are global under .inst (D53, D76): no scoped attribute on every element.
 */
import type { InstrumentCard } from "../lib/instruments";
interface Props { cards: InstrumentCard[] }
const { cards } = Astro.props;
---
<ul class="inst">{cards.map((c) => <li><a href={c.href}><b>{c.name}</b><span class="inst-n">{c.value}</span><p>{c.caption}</p></a></li>)}</ul>
<style is:global>
  .inst { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 560px) { .inst { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .inst { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .inst a { display: grid; align-content: start; gap: 4px; height: 100%; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface); color: var(--text); text-decoration: none; }
  .inst a:hover { border-color: var(--line-strong); }
  .inst b { font-size: 15px; }
  .inst-n { font-size: 28px; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .inst p { margin: 0; color: var(--muted); font-size: 14px; }
</style>
