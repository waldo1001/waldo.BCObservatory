---
/** Version timeline (HANDOFF 4): one column per snapshot major; the versions an object changed in use the accent. */
import { majors, type ObjectHistory } from "../lib/versions";
interface Props { presentIn: string[]; changedIn: string[]; history: ObjectHistory | null; obsolete?: { state?: string; tag?: string } | null }
const { presentIn, changedIn, history, obsolete } = Astro.props;
const cols = majors().map(({ version, label }, i) => {
  const present = presentIn.includes(version);
  const changed = changedIn.includes(version);
  const counts = history?.counts.get(version) ?? {};
  const parts = Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, 2).map(([k, n]) => `${n} ${k}`);
  const objChange = history?.change.get(version);
  const text = !present ? "not present"
    : i === 0 || !presentIn.includes(majors()[i - 1]?.version) ? (objChange === "added" ? "added" : "present")
    : changed ? (parts.join(", ") || (objChange === "changed" ? "declaration changed" : "changed"))
    : "unchanged";
  return { version, label, present, changed, text };
});
---
<section aria-labelledby="timeline" class="tl">
  <h2 class="section-title" id="timeline">Across versions{obsolete?.state && <small>obsolete {String(obsolete.state).toLowerCase()}{obsolete.tag ? ` since ${obsolete.tag}` : ""}</small>}</h2>
  <ol class="timeline">
    {cols.map((c) => (
      <li class:list={[{ changed: c.changed, absent: !c.present }]}>
        <span class="dot" aria-hidden="true"></span>
        <span class="v" title={c.label}>BC{c.version}</span>
        <span class="txt">{c.text}</span>
      </li>
    ))}
  </ol>
</section>
<script>
  // where the row scrolls, show the newest majors first
  for (const ol of document.querySelectorAll<HTMLElement>(".tl .timeline")) if (ol.scrollWidth > ol.clientWidth) ol.scrollLeft = ol.scrollWidth;
</script>
<style>
  /* one row, however many majors (BC23-30 once the older ones are in, D62): it scrolls sideways where it does not fit */
  .timeline { list-style: none; padding: 0 0 6px; margin: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(104px, 1fr); overflow-x: auto; scroll-snap-type: x proximity; }
  .timeline li { scroll-snap-align: end; }
  .timeline li { position: relative; padding: 22px 12px 0 0; display: grid; gap: 2px; }
  .timeline li::before { content: ""; position: absolute; top: 6px; left: 0; right: 0; height: 1px; background: var(--line-strong); }
  .timeline li:last-child::before { right: auto; width: 12px; }
  .dot { position: absolute; top: 2px; left: 0; width: 9px; height: 9px; border-radius: 50%; background: var(--text-2); }
  .changed .dot { top: -1px; left: -3px; width: 15px; height: 15px; background: var(--accent); box-shadow: 0 0 0 3px var(--accent-surface); }
  .absent .dot { background: var(--bg); border: 1px solid var(--line-strong); }
  .v { font: 500 13px var(--font-mono); color: var(--text); }
  .changed .v { color: var(--accent); }
  .txt { font-size: 13px; color: var(--muted); }
</style>
