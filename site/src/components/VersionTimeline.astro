---
/**
 * Version timeline (HANDOFF 4): one column per snapshot major; the versions an object changed in use the accent. A run
 * of majors that say the same thing (present, unchanged, not present) is one column labelled with the range, "BC23-25"
 * (D88: a column was 170 bytes with a 40-byte wave title on each of 25,666 object pages; most objects now fit without
 * the sideways scroll). The scroll to the newest majors, where it still scrolls, is in scripts/chrome.ts (D76).
 */
import { majors, timelineCols, type ObjectHistory } from "../lib/versions";
interface Props { presentIn: string[]; changedIn: string[]; history: ObjectHistory | null; obsolete?: { state?: string; tag?: string } | null }
const { presentIn, changedIn, history, obsolete } = Astro.props;
const merged = timelineCols(majors(), presentIn, changedIn, history);
---
<section aria-labelledby="timeline" class="tl">
  <h2 class="section-title" id="timeline">Across versions{obsolete?.state && <small>obsolete {String(obsolete.state).toLowerCase()}{obsolete.tag ? ` since ${obsolete.tag}` : ""}</small>}</h2>
  <ol class="timeline">
    {merged.map((c) => (
      <li class:list={[{ changed: c.changed, absent: !c.present }]}>
        <span class="dot" aria-hidden="true"></span>
        <span class="v">BC{c.from}{c.to !== c.from ? `-${c.to}` : ""}</span>
        <span class="txt">{c.text}</span>
      </li>
    ))}
  </ol>
</section>
<style is:global>
  /* global under the root class: a scoped style puts a data-astro-cid attribute on every element, on every object page (D53, D76) */
  /* one row, however many majors (BC23-30 once the older ones are in, D62): it scrolls sideways where it does not fit */
  .tl .timeline { list-style: none; padding: 0 0 6px; margin: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(104px, 1fr); overflow-x: auto; scroll-snap-type: x proximity; }
  .tl .timeline li { scroll-snap-align: end; position: relative; padding: 22px 12px 0 0; display: grid; gap: 2px; }
  .tl .timeline li::before { content: ""; position: absolute; top: 6px; left: 0; right: 0; height: 1px; background: var(--line-strong); }
  .tl .timeline li:last-child::before { right: auto; width: 12px; }
  .tl .timeline .dot { position: absolute; top: 2px; left: 0; width: 9px; height: 9px; border-radius: 50%; background: var(--text-2); }
  .tl .timeline .changed .dot { top: -1px; left: -3px; width: 15px; height: 15px; background: var(--accent); box-shadow: 0 0 0 3px var(--accent-surface); }
  .tl .timeline .absent .dot { background: var(--bg); border: 1px solid var(--line-strong); }
  .tl .timeline .v { font: 500 13px var(--font-mono); color: var(--text); }
  .tl .timeline .changed .v { color: var(--accent); }
  .tl .timeline .txt { font-size: 13px; color: var(--muted); }
</style>
