---
/**
 * The information page skeleton (HANDOFF 3): breadcrumb, identity row, title, summary, stat tiles, actions, then main and
 * side columns. The side column ends with the locator, Related (D65: data/links/related.json) and the provenance list,
 * closed by default (D88: tier and review are badges in the identity row; the hash lost its 64-char title).
 */
import Base from "./Base.astro";
import Badges from "../components/Badges.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import PageGalaxy from "../components/PageGalaxy.astro";
import Related from "../components/Related.astro";

import { openInClaude, pageSystem, systemLabel } from "../lib/page";
import { actionOrder, systemChip, trail, type Crumb } from "../lib/crumbs";
import type { SectionId } from "../../../pipeline/lib/sections";
interface Stat { n: number | string; label: string; href?: string }
interface Props {
  fm: Record<string, any>; kind: string; path: string; section: SectionId;
  /** The parents below the section (D90): an object's type, a hub's parent topic, a post's source. */
  crumbs?: Crumb[]; stats?: Stat[]; context?: { label: string; href: string; opens?: "stage" }; ns?: string; summary?: string | null;
  /** The side column's connections graph (ego graph); object pages draw their own neighbourhood instead. */
  connections?: boolean;
  /** A source's own icon in the identity row (D60 phase 2): the blog's favicon or the channel's avatar, hotlinked. */
  icon?: string | null;
}
const { fm, kind, path, section, crumbs = [], stats = [], context, ns, summary = fm.summary, connections = true, icon } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = new URL(base, Astro.site ?? "https://waldo1001.github.io").href;
const mdUrl = `${base}${path}.md`;
const mdName = `${path.split("/").pop()}.md`;
const system = pageSystem(fm);
// D90: crumbs follow the section tree; the galaxy system is a chip in the identity row, not a crumb
const all = trail(base, section, crumbs, String(fm.title));
const chip = systemChip(system, section, systemLabel(system), base);
const stageFirst = actionOrder(context) === "context";
const long = String(fm.title).length > 38;
const g = fm.generated ?? {};
---
<Base title={`${fm.title} · BC Observatory`} description={fm.summary} markdown={mdUrl} section={section}>
  <main class="wrap page">
    <Breadcrumb crumbs={all} />
    <div class="identity" style={system ? `--sys:var(--sys-${system})` : undefined}>
      {icon && <img class="identity-icon" src={icon} alt="" width="20" height="20" loading="lazy" decoding="async" referrerpolicy="strict-origin-when-cross-origin" onerror="this.remove()" />}
      <span class="type-label">{kind}</span>
      {chip && <a href={chip.href}>{chip.label}</a>}
      <Badges tier={fm.tier} review={fm.review?.state} status={fm.type === "feature" ? fm.status : null} />
      {fm.obsolete?.state && <span class="badge obsolete">obsolete - {String(fm.obsolete.state).toLowerCase()}</span>}
    </div>
    <h1 class={long ? "long" : undefined}>{fm.title}</h1>
    {ns && <p class="ns">{ns}</p>}
    {summary && <p class="lead">{summary}</p>}
    {stats.length > 0 && (
      <ul class="stats">{stats.map((s) => <li>{s.href ? <a href={s.href}><b>{typeof s.n === "number" ? s.n.toLocaleString("en") : s.n}</b>{s.label}</a> : <span><b>{typeof s.n === "number" ? s.n.toLocaleString("en") : s.n}</b>{s.label}</span>}</li>)}</ul>
    )}
    <div class="actions">
      {/* D90 (F5): where the context action opens the page's own stage (Watch here, Read it here) it leads */}
      {context && stageFirst && <a class="btn primary" href={context.href} rel="noopener" data-stage-open aria-expanded="false">{context.label}</a>}
      <a class={stageFirst ? "btn" : "btn primary"} href={openInClaude(String(fm.title), new URL(`${path}.md`, site).href)} rel="noopener">Open in Claude</a>
      <a class="btn mono" href={mdUrl} type="text/markdown">{mdName}</a>
      {context && !stageFirst && <a class="btn" href={context.href} rel="noopener">{context.label}</a>}
    </div>
    <div class="columns">
      <div class="main"><slot /></div>
      <aside class="side" aria-label="About this page">
        <slot name="side" />
        <PageGalaxy id={String(fm.id)} system={system} connections={connections}><slot name="locator" /></PageGalaxy>
        <Related id={String(fm.id)} />
        <details class="prov">
          <summary>Provenance</summary>
          <dl>
            <dt>Tier</dt><dd>{fm.tier}</dd>
            <dt>Review</dt><dd>{fm.review?.state ?? "unreviewed"}{fm.review?.by ? ` by ${fm.review.by}` : ""}</dd>
            {g.at && <><dt>Generated</dt><dd>{String(g.at).slice(0, 10)}</dd></>}
            {g.pipeline && <><dt>Pipeline</dt><dd>{g.pipeline}</dd></>}
            {g.input_hash && <><dt>Input</dt><dd>{String(g.input_hash).slice(0, 12)}</dd></>}
            <dt>Id</dt><dd>{fm.id}</dd>
          </dl>
        </details>
      </aside>
    </div>
  </main>
  <script>
    // the locator, the connections (PageGalaxy.astro) and the video dialog in one module: a module tag per component
    // cost about 125 bytes on each of 28,000 pages (D76). The dialog's markup is built on the first video chip click
    // (source-stage.ts): shipped on every page it was 371 bytes × 28,850 pages (D88)
    import { mountConnections, mountLocator } from "../scripts/locator";
    import { mountStageDialog } from "../scripts/source-stage";
    // D89: an object page's reading aids (section list, member filters, change chips, ...), built from its own markup
    import { mountObjectPage } from "../scripts/object-page";
    for (const el of document.querySelectorAll<HTMLElement>("section.loc")) mountLocator(el);
    for (const el of document.querySelectorAll<HTMLElement>("section.con")) mountConnections(el);
    mountStageDialog();
    mountObjectPage();
  </script>
</Base>
