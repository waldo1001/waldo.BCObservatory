---
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/site.css";
import { landed } from "../lib/state";
interface Props { title: string; description?: string; markdown?: string; section?: string; bare?: boolean }
const { title, description, markdown, section, bare = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const repo = "https://github.com/waldo1001/waldo.BCObservatory";
const nav = [
  // D84: eleven entries; "Objects" and "Countries" are the nav's short names for the AL objects and Localizations sections, so the
  // header keeps one row at 1440 px (the section pages keep their titles). D85: a twelfth entry ("Releases") wrapped the header
  // to 121.5 px at 1440, so /releases/ is reached from the home card and the Changes lede instead (spec section 9 fallback)
  ["topics", "Topics"], ["features", "Roadmap"], ["objects", "Objects"], ["localizations", "Countries"],
  ["videos", "Videos"], ["posts", "Posts"], ["changes", "Changes"], ["digests", "Weekly"], ["sources", "Sources"],
  ["mcp", "MCP"], ["about", "About"], // D84, D83
];
// D70: the week's new videos and posts as a pill in the header, on every page but the home page, where the
// galaxy's own "this week" lens chip is the control (D71); D80 adds the week's code changes as the pill's second half
const week = landed();
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="dark light" />
    <link rel="alternate" type="text/plain" href={`${base}llms.txt`} title="llms.txt" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown" />}
    <link rel="alternate" type="application/rss+xml" href={`${base}rss.xml`} title="BC Observatory weekly" />
    <link rel="stylesheet" href={`${base}tokens.css`} />
    <script is:inline>
      try { const t = localStorage.getItem("bcobs-theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body data-base={base}>
    <a class="skip" href="#content">Skip to content</a>
    {!bare && (
      <header class="site-header">
        <div class="wrap">
          <span class="wordmark"><a href={base}>BC Observatory</a><a class="sub" href={`${base}about/`}>unofficial, made by waldo</a></span>
          <nav class="site-nav" aria-label="Sections">
            {nav.map(([id, label]) => <a href={`${base}${id}/`} aria-current={section === id ? "page" : undefined}>{label}</a>)}
          </nav>
          {(week.count > 0 || week.changes > 0) && section !== "home" && (
            <span class="new-pill" title={`Videos, posts and code changes (merged pull requests) of the 7 days up to ${week.anchor}, lit in the galaxy`}>
              {week.count > 0 && <a href={`${base}#lens=landed&kinds=v,p`}><b>{week.count}</b> new{week.changes > 0 ? "" : " this week"}</a>}
              {week.count > 0 && week.changes > 0 && <span class="sep" aria-hidden="true">·</span>}
              {week.changes > 0 && <a href={`${base}#lens=landed&kinds=c`}><b>{week.changes}</b> PRs</a>}
            </span>
          )}
          <form class="site-search" role="search" action={`${base}search/`} method="get">
            <label class="skip" for="q">Search the knowledge base</label>
            <input id="q" name="q" type="search" placeholder="Search: t18, Sales-Post, OnAfterPostSalesDoc, BE" autocomplete="off" />
            <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch light or dark theme" title="Switch theme">◐</button>
            <button class="icon-btn pal-btn" type="button" data-palette aria-label="Find an AL object (Ctrl+K)" title="Find an AL object (Ctrl+K or ⌘K)">⌘K</button>
          </form>
        </div>
      </header>
    )}
    <div id="content"><slot /></div>
    {!bare && (
      <footer class="site-footer">
        <div class="wrap">
          <p>BC Observatory is unofficial and not affiliated with Microsoft. Made by waldo, rebuilt every night.</p>
          <p>
            <a href={repo}>Repository</a> · code MIT, content CC BY 4.0 · <a href={`${base}llms.txt`}>llms.txt</a> ·
            <a href={`${base}mcp/`}>MCP server</a> · <a href={`${base}mcp/#plugin`}>Claude Code plugin</a> · <a href={`${base}code/versions/`}>Version lens</a> · <a href={`${base}code/deprecations/`}>Deprecation radar</a> · <a href={`${base}events/`}>Events</a> · <a href={`${base}coverage/`}>Coverage</a> · <a href={`${base}drift/`}>Drift</a> ·
            <a href={`${base}rss.xml`}>RSS</a> · <a href={`${repo}/issues`}>Report a problem</a>
          </p>
        </div>
      </footer>
    )}
    <script>
      import { mountPalette } from "../scripts/palette";
      import { mountChrome } from "../scripts/chrome";
      mountChrome();
      mountPalette(document.body.dataset.base ?? "/");
    </script>
  </body>
</html>
