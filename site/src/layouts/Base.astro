---
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/site.css";
import { landed } from "../lib/state";
import { navSections } from "../../../pipeline/lib/sections";
interface Props { title: string; description?: string; markdown?: string; section?: string; bare?: boolean }
const { title, description, markdown, section, bare = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const repo = "https://github.com/waldo1001/waldo.BCObservatory";
// D90: the eleven sections under their one names (pipeline/lib/sections.ts), in three groups that site.css spaces apart
// (nth-child 5 and 10, pinned by tests/unit/sections.test.ts). Under 900 px the header is a bar (wordmark, search,
// Browse) and Browse opens the nav, the week pill and Theme as a bottom sheet through the popover API, no script; from
// 900 px the popover wrapper is display: contents and the header is two tiers: wordmark, pill, search and tools; the nav.
const nav = navSections();
// D70: the week's new videos and posts as a pill in the header, on every page but the home page, where the
// galaxy's own "this week" lens chip is the control (D71); D80 adds the week's code changes as the pill's second half.
// D88: every byte of this header is on 28,899 pages: short attributes, no title where an aria-label names the control.
// D90: the Theme and finder buttons do nothing without script, so chrome.ts builds them into #menu
const week = landed();
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="dark light" />
    <link rel="alternate" type="text/plain" href={`${base}llms.txt`} title="llms.txt" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown" />}
    <link rel="alternate" type="application/rss+xml" href={`${base}rss.xml`} title="BC Observatory weekly" />
    <link rel="stylesheet" href={`${base}tokens.css`} />
    <script is:inline>try{var t=localStorage.getItem("bcobs-theme");if(t=="light"||t=="dark")document.documentElement.dataset.theme=t}catch(e){}</script>
  </head>
  <body data-base={base}>
    <a class="skip" href="#content">Skip to content</a>
    {!bare && (
      <header class="site-header">
        <div class="wrap">
          <span class="wordmark"><a href={base}>BC Observatory</a><a class="sub" href={`${base}about/`}>unofficial, made by waldo</a></span>
          <form class="site-search" role="search" action={`${base}search/`} method="get"><input id="q" aria-label="Search" name="q" type="search" placeholder="Search: t18, Sales-Post, BE" autocomplete="off" /></form>
          <button type="button" popovertarget="menu">Browse</button>
          <div id="menu" popover>
            {(week.count > 0 || week.changes > 0) && section !== "home" && (
              <span class="new-pill">
                {week.count > 0 && <a href={`${base}#lens=landed&kinds=v,p`}><b>{week.count}</b> new this week</a>}
                {week.count > 0 && week.changes > 0 && <span class="sep" aria-hidden="true">·</span>}
                {week.changes > 0 && <a href={`${base}#lens=landed&kinds=c`}><b>{week.changes}</b> PRs</a>}
              </span>
            )}
            <nav class="site-nav" aria-label="Sections">
              {nav.map((s) => <a href={`${base}${s.path}`} aria-current={section === s.id ? "page" : undefined}>{s.name}</a>)}
            </nav>
          </div>
        </div>
      </header>
    )}
    <div id="content"><slot /></div>
    {!bare && (
      <footer class="site-footer">
        <div class="wrap">
          <p>BC Observatory is unofficial and not affiliated with Microsoft. Made by waldo, rebuilt every night.</p>
          <p>
            {/* one line: Astro drops the whitespace at a line break, which glued "·" to the next link */}
            <a href={repo}>Repository</a> · code MIT, content CC BY 4.0 · <a href={`${base}llms.txt`}>llms.txt</a> · <a href={`${base}mcp/`}>MCP server and plugin</a> · <a href={`${base}objects/#instruments`}>Instruments</a> · <a href={`${base}rss.xml`}>RSS</a> · <a href={`${repo}/issues`}>Report a problem</a>
          </p>
        </div>
      </footer>
    )}
    <script>
      import { mountPalette } from "../scripts/palette";
      import { mountChrome } from "../scripts/chrome";
      mountChrome();
      mountPalette(document.body.dataset.base ?? "/");
    </script>
  </body>
</html>
