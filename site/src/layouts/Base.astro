---
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/site.css";
import { questions } from "../lib/questions";
import { landed } from "../lib/state";
interface Props { title: string; description?: string; markdown?: string; section?: string; bare?: boolean }
const { title, description, markdown, section, bare = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const repo = "https://github.com/waldo1001/waldo.BCObservatory";
const nav = [
  ["topics", "Topics"], ["features", "Roadmap"], ["objects", "AL objects"], ["localizations", "Localizations"],
  ["videos", "Videos"], ["posts", "Posts"], ["digests", "Weekly"], ["sources", "Sources"],
];
// D70: the question entries and the week's new videos and posts sit in the header, on every page
const asks = questions(base);
const week = landed();
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="dark light" />
    <link rel="alternate" type="text/plain" href={`${base}llms.txt`} title="llms.txt" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown" />}
    <link rel="alternate" type="application/rss+xml" href={`${base}rss.xml`} title="BC Observatory weekly" />
    <link rel="stylesheet" href={`${base}tokens.css`} />
    <script is:inline>
      try { const t = localStorage.getItem("bcobs-theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body data-base={base}>
    <a class="skip" href="#content">Skip to content</a>
    {!bare && (
      <header class="site-header">
        <div class="wrap">
          <a class="wordmark" href={base}>BC Observatory<small>unofficial, made by waldo</small></a>
          <nav class="site-nav" aria-label="Sections">
            {nav.map(([id, label]) => <a href={`${base}${id}/`} aria-current={section === id ? "page" : undefined}>{label}</a>)}
          </nav>
          <details class="ask">
            <summary>Questions</summary>
            <ul>
              {asks.map((q) => <li><a href={q.href}><b>{q.ask}</b><span class="mono-meta">{q.where}</span></a></li>)}
            </ul>
          </details>
          {week.count > 0 && (
            <a class="new-pill" href={`${base}#lens=landed`} title={`Videos and posts of the 7 days up to ${week.anchor}, lit in the galaxy`}>
              <b>{week.count}</b> new this week
            </a>
          )}
          <form class="site-search" role="search" action={`${base}search/`} method="get">
            <label class="skip" for="q">Search the knowledge base</label>
            <input id="q" name="q" type="search" placeholder="Search: table 18, Sales-Post, BE" autocomplete="off" />
            <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch light or dark theme" title="Switch theme">◐</button>
            <button class="icon-btn pal-btn" type="button" data-palette aria-label="Find an AL object (Ctrl+K)" title="Find an AL object (Ctrl+K or ⌘K)">⌘K</button>
          </form>
        </div>
      </header>
    )}
    <div id="content"><slot /></div>
    {!bare && (
      <footer class="site-footer">
        <div class="wrap">
          <p>BC Observatory is unofficial and not affiliated with Microsoft. Made by waldo, rebuilt every night.</p>
          <p>
            <a href={repo}>Repository</a> · code MIT, content CC BY 4.0 · <a href={`${base}llms.txt`}>llms.txt</a> ·
            MCP: <code>npx bc-observatory</code> · <a href={`${base}code/versions/`}>Version lens</a> · <a href={`${base}code/deprecations/`}>Deprecation radar</a> · <a href={`${base}events/`}>Events</a> · <a href={`${base}coverage/`}>Coverage</a> · <a href={`${base}drift/`}>Drift</a> ·
            <a href={`${base}rss.xml`}>RSS</a> · <a href={`${repo}/issues`}>Report a problem</a>
          </p>
        </div>
      </footer>
    )}
    <script>
      import { mountPalette } from "../scripts/palette";
      mountPalette(document.body.dataset.base ?? "/");
    </script>
    <script is:inline>
      // the header's height as --hdr-h, so a page can fill the rest of the viewport (the home galaxy, D70)
      const hdr = document.querySelector(".site-header");
      if (hdr) {
        const set = () => document.documentElement.style.setProperty("--hdr-h", `${hdr.offsetHeight}px`);
        set();
        if (window.ResizeObserver) new ResizeObserver(set).observe(hdr);
      }
      // the questions menu closes on Esc, on a click outside it and on a pick (a same-page hash link would leave it open)
      for (const d of document.querySelectorAll("details.ask")) {
        document.addEventListener("click", (e) => { if (d.open && (!d.contains(e.target) || e.target.closest("a"))) d.open = false; });
        d.addEventListener("keydown", (e) => { if (e.key === "Escape" && d.open) { d.open = false; d.querySelector("summary").focus(); } });
      }
      for (const b of document.querySelectorAll("[data-theme-toggle]")) b.addEventListener("click", () => {
        const root = document.documentElement;
        const now = root.dataset.theme || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        const next = now === "light" ? "dark" : "light";
        root.dataset.theme = next;
        try { localStorage.setItem("bcobs-theme", next); } catch {}
        dispatchEvent(new Event("bcobs-theme"));
      });
    </script>
  </body>
</html>
